[Unit]
Description=Renew only media.herong.info with isolated Certbot configuration
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/herong-media-cert/cloud.env
ConditionPathExists=/etc/herong-media-acme/cli.ini
ConditionPathExists=/etc/herong-media-acme/live/media.herong.info/fullchain.pem

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/ask-around-test/certbot/bin/certbot renew --non-interactive --config /etc/herong-media-acme/cli.ini --cert-name media.herong.info --config-dir /etc/herong-media-acme --work-dir /var/lib/herong-media-acme --logs-dir /var/log/herong-media-acme
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/herong-media-acme /var/lib/herong-media-acme /var/log/herong-media-acme /var/lib/herong-media-cert
