[Unit]
Description=Reconcile media.herong.info Certbot certificate with TOS
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/letsencrypt/live/media.herong.info/fullchain.pem

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/herong-media-cert/venv/bin/python /opt/herong-media-cert/media_cert.py reconcile
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/herong-media-cert
