# Copy into /etc/herong-dev-guides-author/publishing.env after preparing the executor.
# These are trusted server settings, never VITE_ or PUBLIC_ variables.
PUBLISHER_DATA_DIR=/var/lib/herong-dev-guides-author/publishing
PUBLISHER_PYTHON=/opt/herong-social-publisher/current/.venv/bin/python
PUBLISHER_SAU_ROOT=/opt/herong-social-publisher/current/.vendor/social-auto-upload
PUBLISHER_RUNNER=/opt/herong-social-publisher/current/runner.py
# Use the reviewed full build: CentOS ffmpeg-free may reject H.264 MP4.
PUBLISHER_FFPROBE=/opt/herong-social-publisher/current/.vendor/ffmpeg/bin/ffprobe
PUBLISHER_UPLOAD_TIMEOUT_MS=1200000
# Initial production allocation; adjust after checking free disk and backup capacity.
PUBLISHER_MAX_STORAGE_BYTES=2147483648
PUBLISHER_MAX_VIDEO_BYTES=536870912
# Keep executables outside DATA: the author installer makes private data files 0600.
PLAYWRIGHT_BROWSERS_PATH=/opt/herong-social-publisher/current/.vendor/browsers
