diff --git a/utils/publishing_hooks.py b/utils/publishing_hooks.py
new file mode 100644
index 0000000..8a60426
--- /dev/null
+++ b/utils/publishing_hooks.py
@@ -0,0 +1,85 @@
+"""Small integration hooks shared by the existing CLI and embedded publisher.
+
+A submit click is never retried. Acceptance must be observed on the platform.
+"""
+INTEGRATION_PROTOCOL_VERSION = 1
+
+import asyncio
+import getpass
+import os
+import uuid
+from pathlib import Path
+from urllib.parse import urlparse
+
+
+async def save_storage_state(context, path):
+    destination = Path(path)
+    destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    temporary = destination.with_name(destination.name + "." + uuid.uuid4().hex + ".tmp")
+    try:
+        await context.storage_state(path=str(temporary))
+        temporary.chmod(0o600)
+        os.replace(temporary, destination)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+async def notify(uploader, event, **payload):
+    hooks = getattr(uploader, "integration_hooks", None)
+    if hooks:
+        return await hooks(event, **payload)
+
+
+async def handle_sms(uploader, page):
+    field = page.locator('input[placeholder*="验证码"], input[placeholder*="短信"]').first
+    if await field.count() and await field.is_visible():
+        code = await notify(uploader, "challenge", kind="sms", message="请输入平台发送的短信验证码")
+        if not code and not getattr(uploader, "integration_hooks", None):
+            import sys
+            if sys.stdin.isatty():
+                code = (await asyncio.to_thread(getpass.getpass, "请输入短信验证码: ")).strip()
+        if not code:
+            raise RuntimeError("需要人工完成短信验证")
+        await field.fill(code)
+        button = page.get_by_text("验证", exact=True).first
+        await button.click(timeout=5000)
+        await field.wait_for(state="hidden", timeout=15000)
+
+
+async def submit_once(uploader, page, button, success_url=None, timeout_seconds=60):
+    if getattr(uploader, "submission_intent_recorded", False):
+        raise RuntimeError("禁止重复提交")
+    # Authorization is durable in the host before any possibly submitting action.
+    await button.wait_for(state="visible", timeout=15000)
+    initial_indicators = set()
+    for text in ("发布成功", "发表成功", "投稿成功"):
+        indicator = page.get_by_text(text, exact=True).first
+        if await indicator.count() and await indicator.is_visible():
+            initial_indicators.add(text)
+    await notify(uploader, "before_submit")
+    uploader.submission_intent_recorded = True
+    # Click timeout is ambiguous: never fall back to JS or click a second time.
+    try:
+        await button.click(timeout=10000)
+    except Exception:
+        pass
+    deadline = asyncio.get_running_loop().time() + timeout_seconds
+    while asyncio.get_running_loop().time() < deadline:
+        actual, expected = urlparse(page.url), urlparse(success_url or "")
+        if success_url and (actual.scheme, actual.netloc, actual.path) == (expected.scheme, expected.netloc, expected.path):
+            uploader.publish_evidence = {"kind": "platform_acceptance", "summary": "平台显示投稿成功页面"}
+            return uploader.publish_evidence
+        for text in ("发布成功", "发表成功", "投稿成功"):
+            if text in initial_indicators:
+                continue
+            try:
+                indicator = page.get_by_text(text, exact=True).first
+                if await indicator.count() and await indicator.is_visible():
+                    uploader.publish_evidence = {"kind": "platform_acceptance", "summary": "平台显示：" + text}
+                    return uploader.publish_evidence
+            except Exception:
+                pass
+        # A challenge after clicking is still inside the submission boundary.
+        await handle_sms(uploader, page)
+        await asyncio.sleep(1)
+    raise RuntimeError("SUBMISSION_UNKNOWN: 未获取平台受理证据，请人工核对")
