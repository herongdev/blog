# 复制为 .env.local；密钥只由本机 Node 服务读取，不使用 VITE_ 前缀。
DASHSCOPE_API_KEY=
# 默认北京地域。使用其他地域 / 工作空间时，填控制台提供的兼容接口地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODELS=qwen-plus,qwen-flash,qwen3-vl-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
PORT=3001
# 本地开发默认仅监听回环地址。容器部署由 Compose 设置以下配置。
APP_BIND_ADDRESS=127.0.0.1
# 指定后精确匹配协议、域名和端口；留空时只允许本机页面的 Origin。
APP_ORIGIN=
APP_CHAT_TIMEOUT_MS=120000
APP_MAX_ACTIVE_GENERATIONS=8
