# Copy to .env.deploy in the repository root. This file contains no API keys.
APP_IMAGE=zhixu-chat:local
APP_REVISION=unknown
APP_ENV_FILE=.env.runtime
APP_ORIGIN=http://127.0.0.1:3001
APP_LOCAL_PORT=3001
APP_CHAT_TIMEOUT_MS=120000
APP_MAX_ACTIVE_GENERATIONS=8
# Public deployment only: domain without scheme, path or port.
SITE_HOST=chat.example.com
ACME_EMAIL=ops@example.com
DEMO_AUTH_FILE=./.secrets/demo-auth.caddy
