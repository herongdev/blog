{
  "name": "@herong/chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --tsconfig tsconfig.server.json server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts server/app.ts --bundle --platform=node --target=node22 --format=esm --packages=external --splitting --tsconfig=tsconfig.server.json --outdir=dist/server",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "check": "npm run lint && npm run test && npm run typecheck",
    "container:build": "docker build -t zhixu-chat:container-test .",
    "test:container": "node tests/container/verify.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
