---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localUrl } from '../config/site.mjs';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
---
<SiteLayout title="页面未找到" description="这个地址没有对应的页面。你可以返回首页，或浏览作品目录。" noindex>
  <section class="not-found works-container"><span class="eyebrow">404</span><h1>页面未找到</h1><p>这个地址没有对应的页面。</p><nav class="product-actions" aria-label="其他入口"><a class="text-link" href={localUrl('/')}><ArrowLeft size={17} aria-hidden="true" />返回首页</a><a class="text-link" href={localUrl('/projects/')}>浏览作品目录<ArrowUpRight size={17} aria-hidden="true" /></a></nav></section>
</SiteLayout>
