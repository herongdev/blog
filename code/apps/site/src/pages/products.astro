---
import SiteLayout from '../layouts/SiteLayout.astro';
import { products, canonicalUrl, localUrl } from '../config/site.mjs';
import { ArrowUpRight } from '@lucide/astro';
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: '我的应用', url: canonicalUrl('/products/'), mainEntity: { '@type': 'ItemList', itemListElement: products.map((product, index) => ({ '@type': 'ListItem', position: index + 1, name: product.title, url: product.href })) } };
---
<SiteLayout title="我的应用" description="我开发和维护的应用与开发工具。" schema={schema}>
  <header class="page-intro works-container"><h1>我的应用</h1><p>我开发和维护的应用与开发工具。</p></header>
  <div class="product-grid works-container">{products.map((product) => <article class="product-item"><span class="eyebrow">{product.status}</span><h2>{product.title}</h2><p>{product.description}</p><div class="product-actions"><a class="text-link" href={product.href} target="_blank" rel="noopener noreferrer">访问官网<ArrowUpRight size={17} aria-hidden="true" /></a><a class="text-link" href={localUrl(product.projectPath)}>查看项目介绍<ArrowUpRight size={17} aria-hidden="true" /></a></div></article>)}</div>
</SiteLayout>
