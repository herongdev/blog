---
import { canonicalUrl, localUrl, NOINDEX, GUIDES_URL, TOOLS_URL } from '../config/site.mjs';
import { renderHeader, renderFooter, themeBootstrapScript, BRAND_LOGO_DATA_URL } from '@herong/site-chrome';
import '@herong/site-chrome/styles.css';
import '../styles/site.css';
import '../styles/project-visuals.css';
interface Props {
  title: string;
  description: string;
  compact?: boolean;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, compact = false, noindex = false, schema } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/');
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${canonicalUrl('/')}#website`, name: '何荣 · 工具与技术资料', url: canonicalUrl('/'), inLanguage: 'zh-CN', author: { '@type': 'Person', name: '何荣', url: canonicalUrl('/about/') } };
const structured = [website, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
const pagePath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length);
const active = pagePath.startsWith('/projects/') ? 'projects' : pagePath.startsWith('/products/') ? 'apps' : pagePath.startsWith('/about/') ? 'about' : undefined;
const header = renderHeader({ homeUrl: localUrl('/'), guidesUrl: GUIDES_URL, toolsUrl: TOOLS_URL, active });
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeBootstrapScript} />
    <title>{title === '何荣 · 技术落地的不同现场' ? title : `${title} · 何荣`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={NOINDEX || noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={BRAND_LOGO_DATA_URL} />
    <link rel="alternate" type="application/rss+xml" title="何荣 · 历史文章 RSS" href={localUrl('/rss.xml')} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="何荣 · 工具与技术资料" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={canonicalUrl('/logo-hr.png')} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <div class:list={['works-site', { 'works-site--compact': compact }]}>
      <a class="works-skip" href="#works-main">跳到主要内容</a>
      <Fragment set:html={header} />
      <main id="works-main" class="works-main"><slot /></main>
      <Fragment set:html={renderFooter()} />
    </div>
    <script>
      import { initSiteChrome } from '@herong/site-chrome/client';
      initSiteChrome(document);
    </script>
  </body>
</html>
