# Optional production file: /etc/herong-dev-guides-author/workspace.env (0600).
# Local mode: provide these settings in the process environment.
# Private originals. Never reuse public MEDIA_* credentials.
WORKSPACE_STORAGE=local
WORKSPACE_MAX_FILE_BYTES=536870912
WORKSPACE_MAX_STORAGE_BYTES=2147483648
WORKSPACE_CACHE_BYTES=536870912

# Optional S3-compatible PRIVATE bucket, prefix-limited credentials on server only.
# Browser resumable chunks -> authenticated service -> verified object storage.
# This does not implement browser-direct STS upload or return public URLs.
# WORKSPACE_STORAGE=s3
# WORKSPACE_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# WORKSPACE_S3_REGION=cn-beijing
# WORKSPACE_S3_BUCKET=your-private-production-materials
# WORKSPACE_S3_ACCESS_KEY_ID=
# WORKSPACE_S3_SECRET_ACCESS_KEY=
# WORKSPACE_S3_SESSION_TOKEN=
# WORKSPACE_S3_PREFIX=content-workspace/originals
# WORKSPACE_S3_FORCE_PATH_STYLE=false
