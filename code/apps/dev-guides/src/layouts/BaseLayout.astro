---
import '../styles/global.css';
import '@herong/site-chrome/styles.css';
import { renderHeader, renderFooter, themeBootstrapScript, BRAND_FAVICON_DATA_URL } from '@herong/site-chrome';
import { AUTHOR_NAME, BLOCK_INDEXING, DEFAULT_SITE_URL, SITE_DESCRIPTION, SITE_NAME } from '../config/site.mjs';
import { withBase } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  omitCanonical?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  omitCanonical = false,
  type = 'website',
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site ?? DEFAULT_SITE_URL).href;
const brandImage = new URL(withBase('/logo-hr.png'), Astro.site ?? DEFAULT_SITE_URL).href;
const safeJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
const analyticsSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const analyticsId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const header = renderHeader({
  homeUrl: import.meta.env.PUBLIC_MAIN_SITE_URL || 'https://herong.info/',
  guidesUrl: import.meta.env.PUBLIC_GUIDES_URL || 'https://dev.herong.info/',
  toolsUrl: import.meta.env.PUBLIC_TOOLS_URL || 'https://herong.info/file-tools',
  active: 'tutorials',
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeBootstrapScript} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    <link rel="icon" type="image/svg+xml" href={BRAND_FAVICON_DATA_URL} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <meta name="robots" content={BLOCK_INDEXING ? 'noindex, nofollow, noarchive' : noindex ? 'noindex, follow' : 'index, follow'} />
    {!omitCanonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={brandImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="何荣 HR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={brandImage} />
    {jsonLd && <script type="application/ld+json" set:html={safeJsonLd} />}
    {analyticsSrc && analyticsId && <script async defer src={analyticsSrc} data-website-id={analyticsId} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-shell">
      <Fragment set:html={header} />
      <main id="main"><slot /></main>
      <Fragment set:html={renderFooter()} />
    </div>
    <script>
      import { initSiteChrome } from '@herong/site-chrome/client';
      initSiteChrome(document);
    </script>
  </body>
</html>
