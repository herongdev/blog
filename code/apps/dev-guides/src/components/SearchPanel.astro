---
import '../styles/filters.css';
import '../styles/search.css';
import { getCollection } from 'astro:content';
import { ListFilter, Search, X, Play } from '@lucide/astro';
import { themes } from '../data/themes';
import { groupByPublicationWeek } from '../lib/catalog';
import { withBase } from '../lib/urls';

interface Props { compact?: boolean; toolOptions?: Array<{ slug: string; name: string }> }
const { compact = false, toolOptions = [] } = Astro.props;
const entries = await getCollection('tutorials');
const visibleThemes = themes.filter((theme) => entries.some((entry) => entry.data.themes.includes(theme.slug)));
const weeks = groupByPublicationWeek(entries);
---

<section class:list={['search-panel', compact && 'search-panel--compact']} id="search" data-search-root data-index-url={withBase('/search-index.json')} aria-label="搜索开发工具教程">
  {!compact && <div class="search-heading"><h2>查找教程</h2></div>}
  <form class="search-form" action={Astro.url.pathname} method="get" role="search">
    <label for="site-search">搜索工具、功能或问题</label>
    <div class="search-field">
      <input id="site-search" name="q" type="search" autocomplete="off" placeholder="例如：两个任务改代码" />
      <button type="submit"><Search aria-hidden="true" />查找</button>
    </div>
    {toolOptions.length > 0 && <fieldset class="tool-chip-filter tool-chip-filter--search">
      <legend>工具</legend>
      <div class="tool-chip-list">
        <label class="tool-chip"><input type="radio" name="tool" value="" checked /><span>全部工具</span></label>
        {toolOptions.map((tool) => <label class="tool-chip"><input type="radio" name="tool" value={tool.slug} /><span>{tool.name}</span></label>)}
      </div>
    </fieldset>}
    {(visibleThemes.length > 0 || weeks.length > 0) && <details class="search-facets" data-search-facets>
      <summary><ListFilter aria-hidden="true" />更多筛选<span data-facet-count></span></summary>
      {visibleThemes.length > 0 && <fieldset class="tool-chip-filter">
        <legend>主题</legend><div class="tool-chip-list">
          <label class="tool-chip"><input type="radio" name="theme" value="" checked /><span>全部主题</span></label>
          {visibleThemes.map((theme) => <label class="tool-chip"><input type="radio" name="theme" value={theme.slug} /><span>{theme.name}</span></label>)}
        </div>
      </fieldset>}
      {weeks.length > 0 && <fieldset class="tool-chip-filter">
        <legend>发布周</legend><div class="tool-chip-list search-week-options">
          <label class="tool-chip"><input type="radio" name="week" value="" checked /><span>全部时间</span></label>
          {weeks.map((week) => <label class="tool-chip"><input type="radio" name="week" value={week.start} /><span>{week.label}</span></label>)}
        </div>
      </fieldset>}
    </details>}
    <button class="search-clear" type="button" data-search-clear hidden><X aria-hidden="true" />清除搜索与筛选</button>
  </form>
  <noscript><p class="search-no-script">搜索需要启用浏览器脚本。你仍可从<a href={withBase('/tools/')}>工具目录</a>浏览已有内容。</p></noscript>
  <div class="search-results" data-search-results hidden>
    <div class="search-results-heading"><h3>全站搜索结果</h3><p role="status" aria-live="polite" data-search-status></p></div>
    <ul data-search-list></ul>
    <button class="search-more" type="button" data-search-more hidden>加载更多</button>
    <button class="search-more" type="button" data-search-retry hidden>重新搜索</button>
  </div>
  <template data-video-icon><Play aria-hidden="true" /></template>
</section>

<script>
  import { rankResults, type SearchItem } from '../lib/search';
  import { withBase } from '../lib/urls';

  const root = document.querySelector<HTMLElement>('[data-search-root]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const input = root.querySelector<HTMLInputElement>('input[name="q"]')!;
    const results = root.querySelector<HTMLElement>('[data-search-results]')!;
    const list = root.querySelector<HTMLUListElement>('[data-search-list]')!;
    const status = root.querySelector<HTMLElement>('[data-search-status]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-search-more]')!;
    const retry = root.querySelector<HTMLButtonElement>('[data-search-retry]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
    const browse = [...document.querySelectorAll<HTMLElement>('[data-browse-content]')];
    const PAGE_SIZE = 12;
    let indexPromise: Promise<SearchItem[]> | undefined;
    let requestSerial = 0; let shown = PAGE_SIZE; let matches: SearchItem[] = [];
    const selected = (name: string) => radios.find((radio) => radio.name === name && radio.checked)?.value ?? '';
    // Keep an unavailable URL filter explicit: it should produce no matches, not silently broaden the query.
    let unavailable: Record<string, string> = {};
    const filters = () => ({ tool: unavailable.tool || selected('tool'), theme: unavailable.theme || selected('theme'), week: unavailable.week || selected('week') });
    function loadIndex() {
      if (!indexPromise) indexPromise = fetch(root!.dataset.indexUrl || withBase('/search-index.json')).then(async (response) => {
        if (!response.ok) throw new Error('搜索索引暂时不可用');
        return await response.json() as SearchItem[];
      }).catch((error) => { indexPromise = undefined; throw error; });
      return indexPromise;
    }
    function syncUrl(submitted = false, push = false) {
      const next = new URL(window.location.href); const values = { q: input.value.trim(), ...filters() };
      for (const [name, value] of Object.entries(values)) { if (value) next.searchParams.set(name, value); else next.searchParams.delete(name); }
      if (submitted) next.hash = 'search';
      if (next.href !== window.location.href) window.history[push ? 'pushState' : 'replaceState']({}, '', next.href);
    }
    function track(event: string, data: Record<string, string | number>) {
      (window as Window & { umami?: { track: (event: string, data: Record<string, string | number>) => void } }).umami?.track(event, data);
    }
    function addGroup(label: string, entries: SearchItem[]) {
      if (!entries.length) return;
      const group = document.createElement('li'); group.className = 'result-group-label'; group.textContent = label; list.append(group);
      for (const entry of entries) {
        const item = document.createElement('li'); item.className = 'search-result-item';
        const heading = document.createElement('a'); heading.href = entry.url; heading.className = 'search-result-title'; heading.textContent = entry.title;
        const meta = document.createElement('span'); meta.textContent = `${entry.toolName} · ${entry.status === 'published' ? '已亲测教程' : '尚未实测'}${entry.publishedAt ? ` · 发布于 ${entry.publishedAt}` : ''}`;
        const summary = document.createElement('p'); summary.textContent = entry.summary;
        const actions = document.createElement('div'); actions.className = 'search-result-actions';
        const textLink = document.createElement('a'); textLink.href = entry.url; textLink.textContent = entry.status === 'published' ? '阅读教程' : '查看功能资料';
        const contentSlug = entry.url.split('/').filter(Boolean).at(-1) ?? 'none';
        const opened = (format: string) => track('search_result_open', { tool: entry.toolSlug, contentSlug, status: entry.status, format, queryLength: input.value.trim().length });
        textLink.addEventListener('click', () => opened('text')); heading.addEventListener('click', () => opened('text')); actions.append(textLink);
        if (entry.videoUrl) {
          const link = document.createElement('a'); link.href = entry.videoUrl; link.target = '_blank'; link.rel = 'noopener noreferrer';
          const icon = root!.querySelector<HTMLTemplateElement>('[data-video-icon]'); if (icon) link.append(icon.content.cloneNode(true));
          link.append(document.createTextNode('观看视频')); link.addEventListener('click', () => opened('video')); actions.append(link);
        }
        item.append(heading, meta, summary, actions); list.append(item);
      }
    }
    function render() {
      list.replaceChildren(); const visible = matches.slice(0, shown);
      const publishedCount = matches.filter((entry) => entry.status === 'published').length;
      status.textContent = matches.length ? `共 ${publishedCount} 篇教程、${matches.length - publishedCount} 条功能资料，已显示 ${visible.length} 条` : '暂无匹配内容，试试更短的关键词或清除筛选。';
      addGroup('已亲测教程', visible.filter((entry) => entry.status === 'published'));
      addGroup('功能资料 · 尚未实测', visible.filter((entry) => entry.status === 'lead'));
      more.hidden = visible.length >= matches.length;
      more.textContent = `加载更多（剩余 ${Math.max(0, matches.length - visible.length)} 条）`;
    }
    async function runSearch() {
      const serial = ++requestSerial; const { tool, theme, week } = filters(); const query = input.value.trim();
      const active = Boolean(query || tool || theme || week);
      results.hidden = !active; clear.hidden = !active; browse.forEach((section) => { section.hidden = active; });
      const facetCount = Number(Boolean(theme)) + Number(Boolean(week));
      const counter = root!.querySelector<HTMLElement>('[data-facet-count]'); if (counter) counter.textContent = facetCount ? `（${facetCount}）` : '';
      list.replaceChildren(); more.hidden = true; retry.hidden = true; shown = PAGE_SIZE;
      if (!active) { matches = []; status.textContent = ''; return; }
      status.textContent = '正在搜索…';
      try {
        const entries = await loadIndex(); if (serial !== requestSerial) return;
        matches = rankResults(entries, query, tool, { theme, week }); render();
      } catch { if (serial === requestSerial) { status.textContent = '搜索暂时不可用，请重试。'; retry.hidden = false; } }
    }
    function restoreUrl() {
      const params = new URLSearchParams(window.location.search); input.value = params.get('q') || ''; unavailable = {};
      for (const name of ['tool', 'theme', 'week']) {
        const value = params.get(name) || ''; const found = radios.find((radio) => radio.name === name && radio.value === value);
        for (const radio of radios.filter((radio) => radio.name === name)) radio.checked = radio === found;
        if (value && !found) unavailable[name] = value;
      }
      const facets = root!.querySelector<HTMLDetailsElement>('[data-search-facets]'); if (facets && (params.get('theme') || params.get('week'))) facets.open = true;
      void runSearch();
    }
    form.addEventListener('submit', (event) => { event.preventDefault(); syncUrl(true); void runSearch().then(() => track('site_search', { tool: filters().tool || 'all', resultCount: matches.length, queryLength: input.value.trim().length })); });
    input.addEventListener('input', () => { syncUrl(); void runSearch(); });
    for (const radio of radios) radio.addEventListener('change', () => { if (radio.checked) { delete unavailable[radio.name]; syncUrl(false, true); void runSearch(); } });
    clear.addEventListener('click', () => { input.value = ''; unavailable = {}; radios.forEach((radio) => { radio.checked = radio.value === ''; }); syncUrl(false, true); void runSearch(); input.focus(); });
    more.addEventListener('click', () => { shown += PAGE_SIZE; render(); });
    retry.addEventListener('click', () => { void runSearch(); });
    window.addEventListener('popstate', restoreUrl); restoreUrl();
  }
</script>
