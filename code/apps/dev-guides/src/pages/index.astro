---
import '../styles/filters.css';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import ContentCard from '../components/ContentCard.astro';
import { sortNewest } from '../lib/catalog';
import { tools } from '../data/tools';
import { themes } from '../data/themes';
import { DEFAULT_SITE_URL, SITE_DESCRIPTION, SITE_NAME } from '../config/site.mjs';
import { withBase } from '../lib/urls';

const entries = sortNewest(await getCollection('tutorials'));
const published = entries.filter((entry) => entry.data.status === 'published');
const featuredEntries = published.filter((entry) => entry.data.featured);
const featured = published.length >= 3 ? featuredEntries.slice(0, 3) : [];
const searchTools = tools.filter((tool) => entries.some((entry) => entry.data.tool === tool.slug));
const publishedTools = tools.filter((tool) => published.some((entry) => entry.data.tool === tool.slug));
const visibleThemes = themes.filter((theme) => published.some((entry) => entry.data.themes.includes(theme.slug)));
const showThemeFilter = published.length >= 3 && visibleThemes.length >= 2;
const showToolFilter = publishedTools.length >= 2;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: new URL(withBase('/'), Astro.site ?? DEFAULT_SITE_URL).href,
  description: SITE_DESCRIPTION,
};
---

<BaseLayout jsonLd={jsonLd} noindex={published.length === 0}>
  <section class="lookup-hero">
    <div class="container lookup-inner">
      <h1>开发工具怎么用？</h1>
      <SearchPanel compact toolOptions={searchTools} />
      {published.length === 0 && <p class="availability">暂无已亲测教程。你仍可搜索功能资料，查看官方出处。</p>}
    </div>
  </section>

  {published.length > 0 && <>
    {featured.length > 0 && <section class="container section featured-section" aria-labelledby="featured-heading">
      <div class="section-header"><div><p class="eyebrow">先看这里</p><h2 id="featured-heading">重点教程</h2></div></div>
      <div class="card-grid">{featured.map((entry) => <ContentCard entry={entry} />)}</div>
    </section>}
    <section class="container section published-section" id="tutorials" aria-labelledby="published-heading">
      <div class="section-header"><div><p class="eyebrow">{published.length <= 2 ? '最近更新' : '全部内容'}</p><h2 id="published-heading">{published.length <= 2 ? '最新教程' : '所有已亲测教程'}</h2></div></div>
      {(showToolFilter || showThemeFilter) && <div class="library-filters" data-library-filters hidden>
        {showToolFilter && <fieldset class="tool-chip-filter tool-chip-filter--library">
          <legend>按工具筛选</legend>
          <div class="tool-chip-list">
            <label class="tool-chip"><input type="radio" name="library-tool" value="" checked data-library-tool /><span>全部工具</span></label>
            {publishedTools.map((tool) => <label class="tool-chip"><input type="radio" name="library-tool" value={tool.slug} data-library-tool /><span>{tool.name}</span></label>)}
          </div>
        </fieldset>}
        {showThemeFilter && <div class="theme-filter" role="group" aria-label="按问题主题筛选">
          <span>按主题筛选</span>
          <button type="button" data-theme-filter="" aria-pressed="true">全部主题</button>
          {visibleThemes.map((theme) => <button type="button" data-theme-filter={theme.slug} aria-pressed="false">{theme.name}</button>)}
        </div>}
      </div>}
      <p class="library-count" role="status" aria-live="polite" data-library-count>{published.length} 篇教程</p>
      <div class="card-grid library-grid" data-library-list>
        {published.map((entry) => <div data-guide-card data-tool={entry.data.tool} data-themes={entry.data.themes.join(',')}><ContentCard entry={entry} /></div>)}
      </div>
    </section>
  </>}
</BaseLayout>

<script>
  const libraryFilters = document.querySelector<HTMLElement>('[data-library-filters]');
  const toolFilters = [...document.querySelectorAll<HTMLInputElement>('[data-library-tool]')];
  const themeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-filter]')];
  const guideCards = [...document.querySelectorAll<HTMLElement>('[data-guide-card]')];
  const count = document.querySelector<HTMLElement>('[data-library-count]');
  let currentTheme = '';
  function filterGuides() {
    const selectedTool = toolFilters.find((filter) => filter.checked)?.value || '';
    let shown = 0;
    for (const card of guideCards) {
      const toolMatches = !selectedTool || card.dataset.tool === selectedTool;
      const themeMatches = !currentTheme || card.dataset.themes?.split(',').includes(currentTheme);
      card.hidden = !(toolMatches && themeMatches);
      if (!card.hidden) shown++;
    }
    if (count) count.textContent = shown ? `${shown} 篇教程` : '这个筛选条件下暂无教程';
  }
  if (guideCards.length) libraryFilters?.removeAttribute('hidden');
  for (const filter of toolFilters) filter.addEventListener('change', filterGuides);
  for (const button of themeButtons) button.addEventListener('click', () => {
    currentTheme = button.dataset.themeFilter || '';
    for (const candidate of themeButtons) candidate.setAttribute('aria-pressed', String(candidate === button));
    filterGuides();
  });
</script>
