---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowseHeader from '../components/BrowseHeader.astro';
import BrowseNav from '../components/BrowseNav.astro';
import GuideList from '../components/GuideList.astro';
import WeekFeed from '../components/WeekFeed.astro';
import { groupByPublicationWeek, publicationWeek, sortNewest } from '../lib/catalog';
import { tools } from '../data/tools';
import { DEFAULT_SITE_URL, SITE_DESCRIPTION, SITE_NAME } from '../config/site.mjs';
import { withBase } from '../lib/urls';
const entries = sortNewest(await getCollection('tutorials'));
const published = entries.filter((entry) => entry.data.status === 'published');
const leads = entries.filter((entry) => entry.data.status === 'lead');
const weeks = groupByPublicationWeek(entries);
const undated = published.filter((entry) => !publicationWeek(entry));
const featured = published.filter((entry) => entry.data.featured).slice(0, 3);
const activeTools = tools.filter((tool) => entries.some((entry) => entry.data.tool === tool.slug));
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL(withBase('/'), Astro.site ?? DEFAULT_SITE_URL).href, description: SITE_DESCRIPTION };
---
<BaseLayout jsonLd={jsonLd} noindex={published.length === 0}>
  <BrowseHeader title="开发工具库" hideTitle toolOptions={activeTools} />
  <div class="container browse-body">
    <BrowseNav active="weeks" />
    <div data-browse-content>
      {featured.length > 0 && <section class="browse-group browse-featured" aria-labelledby="featured-heading"><div class="browse-group-heading"><h2 id="featured-heading">精选教程</h2></div><GuideList entries={featured} /></section>}
      {weeks.length > 0 ? <WeekFeed weeks={weeks.slice(0, 8)} more={weeks.length > 8} /> : <p class="browse-empty-note">{published.length ? '暂无按周归档的教程，可继续阅读下方往期教程。' : '暂无已发布教程，可先查看下方功能资料。'}</p>}
      {undated.length > 0 && <section class="browse-group" aria-labelledby="undated-heading"><div class="browse-group-heading"><h2 id="undated-heading">往期教程</h2><span class="browse-count">{undated.length} 篇</span></div><GuideList entries={undated} /></section>}
      {leads.length > 0 && <section class="browse-group browse-leads" aria-labelledby="leads-heading"><div class="browse-group-heading"><h2 id="leads-heading">功能资料</h2><span class="browse-count">{leads.length} 条 · 尚未实测</span></div><GuideList entries={leads} /></section>}
    </div>
  </div>
</BaseLayout>
