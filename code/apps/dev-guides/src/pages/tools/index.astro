---
import { getCollection } from 'astro:content';
import { ChevronRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowseHeader from '../../components/BrowseHeader.astro';
import BrowseNav from '../../components/BrowseNav.astro';
import { tools } from '../../data/tools';
import { withBase } from '../../lib/urls';
const entries = await getCollection('tutorials');
const hasPublished = entries.some((entry) => entry.data.status === 'published');
const activeTools = tools.filter((tool) => entries.some((entry) => entry.data.tool === tool.slug));
---
<BaseLayout title="按工具找教程" description="按 Codex、Cursor、TRAE、VS Code 等开发工具查找教程和功能资料。" noindex={!hasPublished}>
  <BrowseHeader title="按工具找教程" toolOptions={activeTools} />
  <div class="container browse-body"><BrowseNav active="tools" /><div data-browse-content>
    {activeTools.length === 0 && <section class="browse-empty"><h2>暂无工具内容</h2></section>}
    <div class="browse-directory">{activeTools.map((tool) => {
      const matches = entries.filter((entry) => entry.data.tool === tool.slug);
      const published = matches.filter((entry) => entry.data.status === 'published').length;
      const leads = matches.length - published;
      return <section id={tool.slug} class="browse-directory-item" aria-labelledby={`tool-${tool.slug}`}>
        <p class="browse-category">{tool.category}</p>
        <div class="browse-directory-heading"><h2 id={`tool-${tool.slug}`}><a href={withBase(`/tools/${tool.slug}/`)}>{tool.name}<ChevronRight aria-hidden="true" /></a></h2><p class="browse-count">{published > 0 && `${published} 篇教程`}{published > 0 && leads > 0 && ' · '}{leads > 0 && `${leads} 条功能资料`}</p></div>
        <p class="browse-description">{tool.description}</p>
        <a class="browse-inline-link" href={withBase(`/tools/${tool.slug}/`)}>查看内容<ChevronRight aria-hidden="true" /></a>
      </section>;
    })}</div>
  </div></div>
</BaseLayout>
