# Copy to .env.media.local in this directory. This file is read only by the
# local authoring server and image publisher; never use PUBLIC_ for secrets.
# Selected storage: private herong-media bucket in cn-beijing. Use a separate
# IAM key restricted to dev-guides/tutorials/. Public read and media domain
# must be configured and verified before direct publishing works.
MEDIA_PUBLIC_BASE_URL=https://media.herong.info
MEDIA_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
MEDIA_S3_REGION=cn-beijing
MEDIA_S3_BUCKET=herong-media
MEDIA_S3_ACCESS_KEY_ID=replace_with_restricted_iam_key
MEDIA_S3_SECRET_ACCESS_KEY=replace_with_restricted_iam_secret

# TOS uses virtual-hosted S3 addressing, so leave this false.
# MEDIA_S3_FORCE_PATH_STYLE=false
# MEDIA_S3_SESSION_TOKEN=
